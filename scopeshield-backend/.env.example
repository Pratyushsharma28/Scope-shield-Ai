# Allowed browser frontend origin for CORS.
FRONTEND_ORIGIN=http://localhost:5173

# Required Google Gemini API key. Keep this value server-side.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional supported Gemini text model (defaults to gemini-2.5-flash).
GEMINI_MODEL=gemini-2.5-flash

# Optional request timeout in milliseconds (100-120000, defaults to 30000).
GEMINI_TIMEOUT_MS=30000

# Optional server port (defaults to 3000).
PORT=3000

# Optional request cap for /api/analyze per client per 15 minutes (defaults to 10).
ANALYZE_RATE_LIMIT_MAX_REQUESTS=10
